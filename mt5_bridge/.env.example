# Copy to mt5_bridge/.env on the Windows PC running MT5. Never commit .env.
# Use the same random secret (32+ characters) in Laravel AUTOTRADER_BRIDGE_TOKEN.
MT5_BRIDGE_TOKEN=
MT5_LOGIN=
MT5_SERVER=
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Optional when the intended account's login is already saved in MT5:
MT5_PASSWORD=
MT5_SYMBOL=XAUUSD-STD
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8710
MT5_ENABLE_EXECUTION=false
MT5_ALLOW_LIVE=false
MT5_DEMO_ONLY=false
# Round-trip sizing reserve per lot, in account currency; set actual broker costs when known.
MT5_COMMISSION_PER_LOT=
# UTC is the documented default. Explicit server_wall conversion is only for a
# verified broker clock profile; timestamps must still pass freshness checks.
MT5_TIME_MODE=utc
# MT5_BROKER_WINTER_UTC_MINUTES=120
# MT5_BROKER_SUMMER_UTC_MINUTES=180
# MT5_BROKER_DST_RULE=eu
